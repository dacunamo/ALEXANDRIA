{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.window","deno.unstable"],
    "types": ["node"]
  },
  "imports": {
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.8.0",
    "@prisma/client": "npm:@prisma/client@^7.0.0",
    "pg": "npm:pg@^8.21.0",
    "prisma": "npm:prisma@^7.8.0",
    "prisma/config": "npm:@prisma/config@^7.0.0",
    "@types/pg": "npm:@types/pg@^8.0.0"
  },
  "tasks": {
    "dbtest": "deno run -A --env=.env --watch dbtest.ts",
    "dev": "deno run -A --env=.env --watch main.ts",
    "db:generate": "deno run -A --env=.env npm:prisma generate",
    "db:push": "deno run -A --env=.env npm:prisma db push",
    "db:migrate": "deno run -A --env=.env npm:prisma migrate dev",
    "db:studio": "deno run -A --env=.env npm:prisma studio",
    "db:drop": "deno run -A --env=.env npm:prisma migrate reset"
  },
  "allowScripts": ["npm:@prisma/engines@7.8.0", "npm:prisma@7.8.0"]
}